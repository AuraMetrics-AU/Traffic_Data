      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="47" type-v2="layout-basic" layout-strategy-id="free-form">
          <zone x="1200" y="1000" w="97000" h="4600" id="48" type-v2="text">
            <formatted-text>
              <run fontsize="19" bold="true" fontcolor="#173347">Casualties, protection and recorded flags</run>
            </formatted-text>
