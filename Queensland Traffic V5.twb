          <zone x="1200" y="5800" w="97000" h="7200" id="49" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">These charts use the grouped source files, which share only crash year and police region with the crash table. The two filters apply to the casualty charts. Rates are fatalities per 100 recorded casualties. Uninjured people are not in the data.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="40950" h="42300" id="50" name="Casualties by year and severity" show-title="true" />
          <zone x="42750" y="13600" w="40950" h="42300" id="51" name="Fatalities per 100 casualties by age and road user" show-title="true" />
          <zone x="1200" y="56500" w="40950" h="42300" id="52" name="Fatalities per 100 casualties by protection" show-title="true" />
          <zone x="42750" y="56500" w="40950" h="42300" id="53" name="Serious share with a young driver" show-title="true" />
