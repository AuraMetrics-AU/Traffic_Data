            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="71" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">Each cell is one model and test year. Precision is blank when a model made no fatal predictions. The partial 2025 release covers fewer months. About 1.9% of test crashes were fatal, which is the precision a random ranking would achieve.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="32133" h="42300" id="72" name="Fatal recall by test year" show-title="true" />
          <zone x="33933" y="13600" w="32133" h="42300" id="73" name="Fatal precision by test year" show-title="true" />
          <zone x="66667" y="13600" w="32133" h="42300" id="74" name="False fatal alerts by test year" show-title="true" />
          <zone x="1200" y="56500" w="32133" h="42300" id="75" name="Fatal precision and recall" show-title="true" />
