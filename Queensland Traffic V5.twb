    <dashboard name="Like for like">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources />
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="56" type-v2="layout-basic" layout-strategy-id="free-form">
          <zone x="1200" y="1000" w="97000" h="4600" id="57" type-v2="text">
            <formatted-text>
              <run fontsize="19" bold="true" fontcolor="#173347">Comparisons that allow for differences in mix  ·  fixed periods</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="58" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">Calculated in the notebook for 2020–2024 and unaffected by filters. Recorded ÷ expected compares each region's serious crashes with the number its mix of remoteness and speed zone predicts. Odds ratios compare crashes within the same year and police region. Hover for 95% intervals.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="48500" h="42300" id="59" name="Region severity and road mix 2020–2024" show-title="true" />
          <zone x="50300" y="13600" w="48500" h="42300" id="60" name="Matched odds of a serious outcome 2020–2024" show-title="true" />
          <zone x="1200" y="56500" w="48500" h="42300" id="61" name="Speed and severity, region-years pooled" show-title="true" />
          <zone x="50300" y="56500" w="48500" h="42300" id="62" name="Speed and severity within region and year" show-title="true" />
        </zone>
      </zones>
      <simple-id uuid="{1DF0022A-B992-5598-B0F4-C334743048EE}" />
    </dashboard>
    <dashboard name="Hotspots">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources />
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="63" type-v2="layout-basic" layout-strategy-id="free-form">
