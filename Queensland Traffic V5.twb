          <zone x="1200" y="5800" w="97000" h="7200" id="37" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">Use the filters on the right. Click a mark to filter the other charts, and click it again to clear. Shares are of recorded injury crashes, so they describe severity, not the risk of crashing.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="40950" h="42300" id="38" name="Injury crashes by crash nature" show-title="true" />
