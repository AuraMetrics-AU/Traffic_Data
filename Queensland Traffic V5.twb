          <zone x="84600" y="13600" w="14200" h="8400" id="42" name="Injury crashes by crash nature" mode="checkdropdown" param="[federated.qld01crashes].[none:Crash year:ok]" type-v2="filter" />
          <zone x="84600" y="22600" w="14200" h="8400" id="43" name="Injury crashes by crash nature" mode="checkdropdown" param="[federated.qld01crashes].[none:Police region:nk]" type-v2="filter" />
          <zone x="84600" y="31600" w="14200" h="8400" id="44" name="Injury crashes by crash nature" mode="checkdropdown" param="[federated.qld01crashes].[none:Remoteness area:nk]" type-v2="filter" />
          <zone x="84600" y="40600" w="14200" h="8400" id="45" name="Injury crashes by crash nature" mode="checkdropdown" param="[federated.qld01crashes].[none:Speed zone:nk]" type-v2="filter" />
          <zone x="84600" y="49600" w="14200" h="8400" id="46" name="Injury crashes by crash nature" mode="checkdropdown" param="[federated.qld01crashes].[none:Severity:nk]" type-v2="filter" />
