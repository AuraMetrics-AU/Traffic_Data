            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="65" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">A hotspot has at least ten fatal or hospitalisation crashes, each within 50 m of another. Counts reflect traffic volume as well as risk. The scatter follows the 100 grid cells with the most serious crashes in 2015–2019 into 2020–2024: most record fewer, so expect a fall at any site chosen for a high count.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="48500" h="85200" id="66" name="Serious-crash hotspot map 2011–2024" show-title="true" />
          <zone x="50300" y="13600" w="48500" h="42300" id="67" name="Serious-crash hotspot list 2011–2024" show-title="true" />
          <zone x="50300" y="56500" w="48500" h="42300" id="68" name="Do the top 100 grid cells stay on top" show-title="true" />
        </zone>
      </zones>
      <simple-id uuid="{9A10ECB2-B167-50A3-9FB4-00092F3A6575}" />
    </dashboard>
    <dashboard name="Model evaluation">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources />
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="69" type-v2="layout-basic" layout-strategy-id="free-form">
