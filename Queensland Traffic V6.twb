    <dashboard name="Like for like">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources />
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="74" type-v2="layout-basic" layout-strategy-id="free-form">
          <zone x="1200" y="1000" w="97000" h="4600" id="75" type-v2="text">
            <formatted-text>
