  <dashboards>
    <dashboard name="Start here">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources>
        <datasource caption="Crashes (one row per crash)" name="federated.qld01crashes" />
      </datasources>
      <datasource-dependencies datasource="federated.qld01crashes">
        <column datatype="integer" name="[Crash year]" role="dimension" type="ordinal" />
        <column datatype="string" name="[Police region]" role="dimension" type="nominal" />
        <column datatype="string" name="[Remoteness area]" role="dimension" type="nominal" />
        <column datatype="string" name="[Speed zone]" role="dimension" type="nominal" />
        <column datatype="string" name="[Severity]" role="dimension" type="nominal" />
        <column-instance column="[Crash year]" derivation="None" name="[none:Crash year:ok]" pivot="key" type="ordinal" />
        <column-instance column="[Police region]" derivation="None" name="[none:Police region:nk]" pivot="key" type="nominal" />
        <column-instance column="[Remoteness area]" derivation="None" name="[none:Remoteness area:nk]" pivot="key" type="nominal" />
        <column-instance column="[Speed zone]" derivation="None" name="[none:Speed zone:nk]" pivot="key" type="nominal" />
        <column-instance column="[Severity]" derivation="None" name="[none:Severity:nk]" pivot="key" type="nominal" />
      </datasource-dependencies>
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="1" type-v2="layout-basic" layout-strategy-id="free-form">
          <zone x="1200" y="1000" w="97000" h="4600" id="2" type-v2="text">
            <formatted-text>
              <run fontsize="19" bold="true" fontcolor="#173347">Queensland traffic crashes  ·  V6</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="3" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">Property-damage-only crashes are recorded to 2010 only, so the charts count injury crashes. 2025 is a partial year. The hospitalisation share of injury crashes rises over the series, so compare serious shares within 2020–2024 (see "Severity drift"). Use the filters on the right. Click a mark to filter the other charts, and click it again to clear. Shares are of recorded injury crashes, so they describe severity, not the risk of crashing.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="40950" h="42300" id="4" name="Recorded crashes by year and record type" show-title="true" />
          <zone x="42750" y="13600" w="40950" h="42300" id="5" name="Injury crashes by year and severity" show-title="true" />
          <zone x="1200" y="56500" w="40950" h="42300" id="6" name="Serious share of injury crashes by year" show-title="true" />
          <zone x="42750" y="56500" w="40950" h="42300" id="7" name="Injury crashes by police region" show-title="true" />
          <zone x="84600" y="13600" w="14200" h="8400" id="8" name="Injury crashes by year and severity" mode="checkdropdown" param="[federated.qld01crashes].[none:Crash year:ok]" type-v2="filter" />
          <zone x="84600" y="22600" w="14200" h="8400" id="9" name="Injury crashes by year and severity" mode="checkdropdown" param="[federated.qld01crashes].[none:Police region:nk]" type-v2="filter" />
          <zone x="84600" y="31600" w="14200" h="8400" id="10" name="Injury crashes by year and severity" mode="checkdropdown" param="[federated.qld01crashes].[none:Remoteness area:nk]" type-v2="filter" />
          <zone x="84600" y="40600" w="14200" h="8400" id="11" name="Injury crashes by year and severity" mode="checkdropdown" param="[federated.qld01crashes].[none:Speed zone:nk]" type-v2="filter" />
          <zone x="84600" y="49600" w="14200" h="8400" id="12" name="Injury crashes by year and severity" mode="checkdropdown" param="[federated.qld01crashes].[none:Severity:nk]" type-v2="filter" />
        </zone>
      </zones>
      <simple-id uuid="{14C6D1F1-39F9-5722-9C5B-2F24213ECB44}" />
    </dashboard>
    <dashboard name="Severity drift">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources />
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="13" type-v2="layout-basic" layout-strategy-id="free-form">
          <zone x="1200" y="1000" w="97000" h="4600" id="14" type-v2="text">
            <formatted-text>
              <run fontsize="19" bold="true" fontcolor="#173347">How injury severity is graded changes over time</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="15" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">The hospitalisation share of injury crashes rises from about 30% to 49% while the fatal share stays level. Orange bars are the stable window (2020–2024) used for serious-share comparisons, rules and models; long-run trends should use the fatal share. Calculated in the notebook; not filterable.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="48500" h="85200" id="16" name="Hospitalisation share of injury crashes by year" show-title="true" />
          <zone x="50300" y="13600" w="48500" h="85200" id="17" name="Fatal share of injury crashes by year (severity mix)" show-title="true" />
        </zone>
      </zones>
      <simple-id uuid="{4C4E2E5D-1741-5C1D-A7B0-1C7DF3464511}" />
    </dashboard>
