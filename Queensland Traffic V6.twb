          <zone x="84600" y="13600" w="14200" h="8400" id="73" name="Areas against their road mix (funnel)" mode="checkdropdown" param="[federated.qld20resultareafunnel].[none:Area type:nk]" type-v2="filter" />
        </zone>
      </zones>
