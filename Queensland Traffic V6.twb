            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="84" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">Junctions and road links ranked by empirical-Bayes excess: serious crashes above what each crash's year, site type, speed zone and remoteness predict, shrunk for small sites. Size shows injury crashes; colour shows shrunk excess. Many top links are motorcycle routes (see tooltip). Sites ranked by count kept no excess in the next period; sites ranked by excess did.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="48500" h="85200" id="85" name="Road sites with excess serious crashes 2015–2024" show-title="true" />
          <zone x="50300" y="13600" w="48500" h="42300" id="86" name="Ranked road sites 2015–2024" show-title="true" />
          <zone x="50300" y="56500" w="48500" h="42300" id="87" name="Do ranked sites keep their excess next period" show-title="true" />
        </zone>
      </zones>
      <simple-id uuid="{6F78A08B-651C-5985-A3CD-D456114E8A62}" />
    </dashboard>
    <dashboard name="Model evaluation">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources />
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="88" type-v2="layout-basic" layout-strategy-id="free-form">
