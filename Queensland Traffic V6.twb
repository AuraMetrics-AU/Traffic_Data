          <zone x="66667" y="13600" w="32133" h="85200" id="79" name="Adjusted odds of a serious outcome (crash level) 2020–2024" show-title="true" />
          <zone x="1200" y="56500" w="32133" h="42300" id="80" name="Speed and severity, region-years pooled" show-title="true" />
          <zone x="33933" y="56500" w="32133" h="42300" id="81" name="Speed and severity within region and year" show-title="true" />
        </zone>
