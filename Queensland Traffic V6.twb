            <formatted-text>
              <run fontsize="19" bold="true" fontcolor="#173347">Severity models on held-out years  ·  trained 2020–2022</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="90" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">Validation 2023 sets the fatal alert threshold; 2024 is the test; 2025 is partial. "V5 test years pooled" compares with V5 (best fatal average precision 0.091). About 1.9% of crashes are fatal, which is the average precision a random ranking would achieve.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="32133" h="42300" id="91" name="Model ranking quality (average precision)" show-title="true" />
          <zone x="33933" y="13600" w="32133" h="42300" id="92" name="Fatal precision by evaluation year" show-title="true" />
          <zone x="66667" y="13600" w="32133" h="42300" id="93" name="False fatal alerts by evaluation year" show-title="true" />
          <zone x="1200" y="56500" w="32133" h="42300" id="94" name="Fatal precision and recall" show-title="true" />
          <zone x="33933" y="56500" w="32133" h="42300" id="95" name="Fatal alerts on the test year (confusion matrix)" show-title="true" />
          <zone x="66667" y="56500" w="32133" h="42300" id="96" name="Model permutation importance" show-title="true" />
        </zone>
      </zones>
      <simple-id uuid="{D849AA02-C2CD-51A4-AD24-8D4685793F81}" />
    </dashboard>
    <dashboard name="Reliability">
      <size sizing-mode="fixed" minwidth="1400" maxwidth="1400" minheight="880" maxheight="880" />
      <datasources />
      <zones>
        <zone x="0" y="0" w="100000" h="100000" id="97" type-v2="layout-basic" layout-strategy-id="free-form">
          <zone x="1200" y="1000" w="97000" h="4600" id="98" type-v2="text">
            <formatted-text>
              <run fontsize="19" bold="true" fontcolor="#173347">How far the results can be trusted  ·  reliability experiments</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="5800" w="97000" h="7200" id="99" type-v2="text">
            <formatted-text>
              <run fontsize="10" bold="false" fontcolor="#173347">R1: bootstrap intervals on the 2024 test metrics (hover for limits). R3: fatal ranking falls to 0.05 with only road, time and environment inputs. R4: each dot is a recall target set on 2023 and applied to 2024. R6: how many of the top-100 road sites survive changes to the screening settings.</run>
            </formatted-text>
          </zone>
          <zone x="1200" y="13600" w="48500" h="42300" id="100" name="R1 · bootstrap 95% intervals (test year)" show-title="true" />
          <zone x="50300" y="13600" w="48500" h="42300" id="101" name="R3 · feature ablation" show-title="true" />
          <zone x="1200" y="56500" w="48500" h="42300" id="102" name="R4 · fatal alert threshold sensitivity" show-title="true" />
          <zone x="50300" y="56500" w="48500" h="42300" id="103" name="R6 · site-screening robustness" show-title="true" />
        </zone>
      </zones>
      <simple-id uuid="{DFAFC07D-E15A-558A-99F3-09A2CB763FD1}" />
    </dashboard>
